**/target
node_modules/
packages/*/dist/
packages/app/.expo/
packages/app/android/
packages/app/ios/
client/node_modules/
client/dist/
*.db
*.db-shm
*.db-wal
.env
*.tsbuildinfo
.superpowers/
.claude/
e2e/.generated-certs/
.DS_Store

# Local production operations contain infrastructure-specific details.
docs/deployment/runbook.md

# Regenerated by src-tauri/build.rs on every build, and its contents now
# depend on OFFDESK_MOBILE_HUB_URL, so it differs per builder.
packages/desktop/src-tauri/gen/schemas/capabilities.json

# Sidecars the desktop release build bundles; scripts/desktop-sidecars.sh
# and scripts/build-tmux-sidecar.sh put them here.
packages/desktop/src-tauri/binaries/

# Persistent Hub encryption identity; never commit private keys.
*.secure-key

# Native plugin outputs generated during Android builds.
packages/desktop/*/android/build/
packages/desktop/*/android/.tauri/
