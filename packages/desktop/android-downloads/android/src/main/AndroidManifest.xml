<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Only API 24-28 needs this to write into the public Download folder;
         API 29+ goes through MediaStore and needs no permission. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
</manifest>
