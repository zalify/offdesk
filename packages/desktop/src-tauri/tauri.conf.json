{
  "productName": "offdesk",
  "version": "0.6.4",
  "identifier": "dev.offdesk.desktop",
  "build": {
    "frontendDist": "../../app/dist",
    "devUrl": "http://localhost:8081",
    "beforeBuildCommand": "pnpm --filter @offdesk/desktop build:web",
    "beforeDevCommand": "pnpm --filter @offdesk/shared build && pnpm --filter @offdesk/app dev:web"
  },
  "app": {
    "windows": [
      {
        "title": "offdesk",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "dragDropEnabled": false,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": {
          "width": 600,
          "height": 400
        },
        "appPosition": {
          "x": 150,
          "y": 180
        },
        "applicationFolderPosition": {
          "x": 450,
          "y": 180
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/zalify/offdesk/releases/download/desktop-latest/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5RkZERjcwNUQ4MzFDRkIKUldUN0hJTmRjTi8vS2NsTi80WWg0MDJoK2pmT3AxTE5TWFVMOUhvRVdYd2tvR1M1WnNHSExLbTIK"
    }
  }
}
