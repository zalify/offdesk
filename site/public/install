#!/bin/sh
# offdesk installer.
#   curl -fsSL https://offdesk.dev/install | sh
#
# Installs offdesk-hub, the offdesk-node machine agent and the offdesk CLI from
# the latest release. Defaults to ~/.local/bin. Pass --system to install to
# /usr/local/bin instead; that path re-runs the install step under sudo and
# tells you before it does. Nothing is ever piped into sudo.
#
# Releases are read from offdesk.dev, which mirrors GitHub's: github.com is
# unreliable from mainland China without a proxy, and offdesk.dev is not.
# GitHub is still asked, briefly, in case the mirror lags a release, and
# fully when offdesk.dev cannot answer.
#
# Flags:
#   --system            install to /usr/local/bin (asks sudo for that step)
#   --prefix <dir>      install to <dir>
#   --version <vX.Y.Z>  install a specific release instead of the latest
#   --hub-only          only offdesk-hub, the server
#   --no-service        install the binaries and stop; do not start the hub
#   --hub-url <url> --token <token>
#                       join a hub: install the agent alone, register this
#                       machine with the hub, and keep the agent running as a
#                       service — the one line the hub's "Add host" page shows
#   --node-only         only offdesk-node, the machine agent
#   --cli-only          only the offdesk CLI

set -eu

REPO="zalify/offdesk"
RELEASES="https://github.com/${REPO}/releases"
API="https://api.github.com/repos/${REPO}/releases"
MIRROR="https://offdesk.dev"
MIRROR_RELEASES="${MIRROR}/updates/releases.json"
PREFIX="${OFFDESK_INSTALL_DIR:-$HOME/.local/bin}"
VERSION=""
USE_SUDO=no
WANT_CLI=yes
WANT_NODE=yes
WANT_HUB=yes
NO_SERVICE=no
HUB_URL=""
TOKEN=""

main() {
    parse_args "$@"
    detect_platform
    require_download_tool
    [ "$WANT_NODE" = yes ] && require_tmux

    if [ -z "$VERSION" ]; then
        VERSION=$(latest_version)
    fi

    say "Installing offdesk ${VERSION} (${OS}/${ARCH}) to ${PREFIX}"

    TMPDIR_="$(mktemp -d)"
    trap 'rm -rf "${TMPDIR_}"' EXIT HUP INT TERM

    installed=""
    [ "$WANT_CLI" = yes ] && fetch_binary offdesk && installed="${installed} offdesk"
    [ "$WANT_NODE" = yes ] && fetch_binary offdesk-node && installed="${installed} offdesk-node"
    [ "$WANT_HUB" = yes ] && fetch_binary offdesk-hub && installed="${installed} offdesk-hub"

    ensure_prefix
    for name in $installed; do
        place "$name"
    done

    say ""
    for name in $installed; do
        say "Installed ${PREFIX}/${name}"
    done
    report_path
    if [ -n "$HUB_URL" ]; then
        join_hub
    elif [ "$WANT_HUB" = yes ] && [ "$NO_SERVICE" = no ]; then
        start_hub
    else
        report_next_steps
    fi
}

# ── arguments ────────────────────────────────────────────────────────

parse_args() {
    while [ $# -gt 0 ]; do
        case "$1" in
            --system)
                PREFIX="/usr/local/bin"
                USE_SUDO=yes
                ;;
            --prefix)
                shift
                [ $# -gt 0 ] || die "--prefix needs a directory"
                PREFIX="$1"
                ;;
            --version)
                shift
                [ $# -gt 0 ] || die "--version needs a tag, e.g. v0.4.0"
                VERSION="$1"
                ;;
            --hub-only)
                WANT_CLI=no
                WANT_NODE=no
                ;;
            --node-only)
                WANT_CLI=no
                WANT_HUB=no
                ;;
            --cli-only)
                WANT_NODE=no
                WANT_HUB=no
                ;;
            --no-service)
                NO_SERVICE=yes
                ;;
            --hub-url)
                shift
                [ $# -gt 0 ] || die "--hub-url needs the hub's address"
                HUB_URL="$1"
                ;;
            --token)
                shift
                [ $# -gt 0 ] || die "--token needs the registration token from the hub"
                TOKEN="$1"
                ;;
            # Accepted for scripts written against the previous version.
            --hub) ;;
            -h|--help)
                usage
                exit 0
                ;;
            *) die "unknown option: $1" ;;
        esac
        shift
    done

    if [ "$WANT_CLI" = no ] && [ "$WANT_NODE" = no ] && [ "$WANT_HUB" = no ]; then
        die "the --*-only options cannot be combined"
    fi

    # Joining a hub is what --node-only was for; the flags say it outright.
    if [ -n "$HUB_URL" ] || [ -n "$TOKEN" ]; then
        [ -n "$HUB_URL" ] && [ -n "$TOKEN" ] || die "--hub-url and --token go together; the hub's Add host page prints both"
        WANT_CLI=no
        WANT_HUB=no
        WANT_NODE=yes
    fi
}

usage() {
    cat <<'EOF'
offdesk installer.
  curl -fsSL https://offdesk.dev/install | sh

Installs offdesk-hub, the offdesk-node machine agent and the offdesk CLI from
the latest release (offdesk.dev's mirror, else GitHub). Defaults to ~/.local/bin.

  --system            install to /usr/local/bin (asks sudo for that step)
  --prefix <dir>      install to <dir>
  --version <vX.Y.Z>  install a specific release instead of the latest
  --hub-only          only offdesk-hub, the server
  --node-only         only offdesk-node, the machine agent
  --cli-only          only the offdesk CLI
  --no-service        install the binaries and stop; do not start the hub
  --hub-url <url> --token <token>
                      join a hub: install the agent, register this machine
                      with it, keep the agent running as a service

Nothing is ever piped into sudo.
EOF
}

# ── environment ──────────────────────────────────────────────────────

detect_platform() {
    os_raw=$(uname -s)
    arch_raw=$(uname -m)

    case "$os_raw" in
        Linux) OS="linux" ;;
        Darwin) OS="darwin" ;;
        *) die "unsupported OS: ${os_raw}. offdesk builds for Linux and macOS; \
build from source with: cargo build --release" ;;
    esac

    case "$arch_raw" in
        x86_64|amd64) ARCH="x64" ;;
        aarch64|arm64) ARCH="arm64" ;;
        *) die "unsupported architecture: ${arch_raw}. Build from source with: \
cargo build --release" ;;
    esac
}

require_download_tool() {
    if command -v curl >/dev/null 2>&1; then
        DL=curl
    elif command -v wget >/dev/null 2>&1; then
        DL=wget
    else
        die "curl or wget is required"
    fi
}

require_tmux() {
    command -v tmux >/dev/null 2>&1 && return 0
    cat >&2 <<'EOF'
error: offdesk-node needs tmux, and tmux is not installed.

  Debian / Ubuntu:  sudo apt install tmux
  macOS (Homebrew): brew install tmux
  Arch:             sudo pacman -S tmux

Install it and run this again, or pass --cli-only to install just the CLI.
EOF
    exit 1
}

# ── release lookup ───────────────────────────────────────────────────

fetch() {
    # fetch <url> -> stdout; non-zero on any HTTP error
    if [ "$DL" = curl ]; then
        curl -fsSL "$1" 2>/dev/null
    else
        wget -qO- "$1" 2>/dev/null
    fi
}

http_status() {
    # http_status <url> -> the status code, or 000 if the request never
    # completed. Used only to tell "GitHub said no" apart from "no GitHub",
    # which are very different things to be told at 2am.
    if [ "$DL" = curl ]; then
        curl -sSL -o /dev/null -w '%{http_code}' "$1" 2>/dev/null || printf '000'
    else
        printf '000'
    fi
}

fetch_quick() {
    # fetch, but giving up after 15 seconds: for a second opinion that is
    # fine to go without
    if [ "$DL" = curl ]; then
        curl -fsSL --connect-timeout 5 --max-time 15 "$1" 2>/dev/null
    elif wget --version >/dev/null 2>&1; then
        # GNU wget tries 20 times by default.
        wget -qO- -T 15 -t 1 "$1" 2>/dev/null
    else
        # BusyBox wget never retries, and knows no -t.
        wget -qO- -T 15 "$1" 2>/dev/null
    fi
}

fetch_to() {
    # fetch_to <url> <dest>; non-zero on any HTTP error
    if [ "$DL" = curl ]; then
        curl -fsSL -o "$2" "$1" 2>/dev/null
    else
        wget -qO "$2" "$1" 2>/dev/null
    fi
}

latest_version() {
    # Newest vX.Y.Z tag. desktop-v* and app-v* ship the desktop and Android
    # apps and carry no CLI or node binaries, so they are skipped. The
    # mirror's listing has GitHub's shape. With it in hand GitHub's only
    # confirms, quickly, that no newer release is out; without it GitHub's
    # answer is the one that counts, and its errors are explained.
    mirror=$(fetch "$MIRROR_RELEASES" 2>/dev/null | newest_tag) || mirror=""
    if [ -n "$mirror" ]; then
        github=$(fetch_quick "$API" 2>/dev/null | newest_tag) || github=""
    else
        body=$(fetch "$API" 2>/dev/null) || api_unreachable
        github=$(printf '%s' "$body" | newest_tag) || github=""
    fi
    version=$(printf '%s\n%s\n' "$mirror" "$github" | grep . | sort -V | tail -n 1) || version=""
    [ -n "$version" ] || no_release "no vX.Y.Z release exists yet"
    printf '%s' "$version"
}

newest_tag() {
    # A releases listing on stdin -> its highest vX.Y.Z tag, or nothing.
    grep -oE '"tag_name"[[:space:]]*:[[:space:]]*"v[0-9]+\.[0-9]+\.[0-9]+"' \
        | sed -E 's/.*"(v[0-9]+\.[0-9]+\.[0-9]+)"/\1/' \
        | sort -V \
        | tail -n 1
}

api_unreachable() {
    status=$(http_status "$API")
    case "$status" in
        404)
            die "${API} returned 404 — the repository is gone or renamed.
       This installer is out of date; get a current one from
       https://offdesk.dev/install"
            ;;
        403|429)
            die "GitHub rate-limited this machine (HTTP ${status}).
       Wait a few minutes, or download a binary by hand from ${RELEASES}"
            ;;
        000)
            die "could not reach ${API}. Check your network or a proxy."
            ;;
        *)
            die "${API} returned HTTP ${status}. Try again, or download a
       binary by hand from ${RELEASES}"
            ;;
    esac
}

fetch_binary() {
    name="$1"
    artifact="${name}-${OS}-${ARCH}"
    # offdesk.dev serves its copy, or redirects to GitHub's when it has none;
    # GitHub directly is for when offdesk.dev itself cannot be reached.
    if ! fetch_to "${MIRROR}/download/${VERSION}/${artifact}" "${TMPDIR_}/${name}" \
        && ! fetch_to "${RELEASES}/download/${VERSION}/${artifact}" "${TMPDIR_}/${name}"; then
        no_release "release ${VERSION} has no ${artifact}"
    fi
    chmod +x "${TMPDIR_}/${name}"
}

no_release() {
    cat >&2 <<EOF
error: $1

offdesk may not have published binaries for ${OS}/${ARCH} yet. Build from
source instead — it needs a Rust toolchain and takes a minute:

  git clone https://github.com/${REPO} && cd ${REPO#*/}
  cargo build --release --bin offdesk --bin offdesk-node
  cp target/release/offdesk target/release/offdesk-node ${PREFIX}/

Releases: ${RELEASES}
EOF
    exit 1
}

# ── install ──────────────────────────────────────────────────────────

ensure_prefix() {
    [ -d "$PREFIX" ] && return 0
    if [ "$USE_SUDO" = yes ]; then
        say "Creating ${PREFIX} (needs sudo)"
        sudo mkdir -p "$PREFIX"
    else
        mkdir -p "$PREFIX"
    fi
}

place() {
    name="$1"
    src="${TMPDIR_}/${name}"
    dest="${PREFIX}/${name}"

    # Move rather than copy over the destination: `mv` swaps the directory
    # entry, so replacing a binary that a running service still has open does
    # not fail with "text file busy".
    if [ "$USE_SUDO" = yes ]; then
        say "Writing ${dest} (needs sudo)"
        sudo mv -f "$src" "$dest"
    else
        if [ -e "$dest" ] && [ ! -w "$dest" ]; then
            die "${dest} is not writable. Re-run with --system to use sudo, \
or with --prefix <dir> to install somewhere you own."
        fi
        mv -f "$src" "$dest"
    fi
}

# ── reporting ────────────────────────────────────────────────────────

report_path() {
    case ":${PATH}:" in
        *":${PREFIX}:"*) return 0 ;;
    esac
    say ""
    say "${PREFIX} is not on your PATH. Add it:"
    case "$(basename "${SHELL:-sh}")" in
        fish) say "  fish_add_path ${PREFIX}" ;;
        zsh) say "  echo 'export PATH=\"${PREFIX}:\$PATH\"' >> ~/.zshrc" ;;
        *) say "  echo 'export PATH=\"${PREFIX}:\$PATH\"' >> ~/.bashrc" ;;
    esac
}

# The one-line install ends with a running hub, this machine registered to
# it, and the sign-in link on the terminal — as a QR code, so the phone is
# one scan away. `offdesk-hub service install` does all of that; the hub
# runs at login from now on. A person who wants only the binaries passes
# --no-service and gets the old "Next:" text.
start_hub() {
    say ""
    say "Starting the hub as a service and registering this machine with it."
    if ! "${PREFIX}/offdesk-hub" service install; then
        say ""
        say "The hub did not start. Run it in the foreground to see why:"
        say "  offdesk-hub"
        return 0
    fi
    case " ${installed} " in
        *" offdesk "*)
            say "For the CLI, create an API token under Settings and set"
            say "OFFDESK_URL and OFFDESK_TOKEN, or write ~/.config/offdesk/config.toml."
            ;;
    esac
}

# Joining a hub from the one line its "Add host" page shows: register this
# machine, then keep the agent running. Registering restarts an agent
# service that is already installed, so the same line also moves a machine
# from one hub to another, or re-registers the machine the hub runs on.
join_hub() {
    say ""
    say "Registering this machine with ${HUB_URL}."
    if ! "${PREFIX}/offdesk-node" register --hub-url "$HUB_URL" --token "$TOKEN"; then
        say ""
        say "Registration did not go through. The token works once and expires"
        say "after 24 hours; take a fresh line from the hub's Add host page."
        return 0
    fi
    "${PREFIX}/offdesk-node" service install || {
        say ""
        say "The agent is registered but not running as a service. Start it:"
        say "  offdesk-node service install"
        return 0
    }
    say ""
    say "This machine is connected. It shows up on the hub now, and the agent"
    say "starts at login from here on."
}

report_next_steps() {
    say ""
    case " ${installed} " in
        *" offdesk-hub "*)
            say "Next: start the hub."
            say "  offdesk-hub"
            say ""
            say "It prints a link that signs you in. To keep it running after"
            say "you close this terminal, and across reboots:"
            say "  offdesk-hub service install"
            say ""
            ;;
    esac
    case " ${installed} " in
        *" offdesk-node "*)
            say "Next: register this machine with your hub. Open the hub in a"
            say "browser and choose Add host: it shows one line that installs,"
            say "registers and starts the agent, with a token filled in. Or:"
            say "  offdesk-node register --hub-url https://your-hub.example.com --token <token>"
            say "  offdesk-node service install"
            ;;
    esac
    case " ${installed} " in
        *" offdesk "*)
            say ""
            say "For the CLI, set OFFDESK_URL and OFFDESK_TOKEN, or write"
            say "~/.config/offdesk/config.toml. See ${RELEASES%/releases}#readme"
            ;;
    esac

    if [ "$OS" = linux ] && systemctl --user is-active offdesk-node >/dev/null 2>&1; then
        say ""
        say "The offdesk-node service is running an older binary. Restart it:"
        say "  offdesk-node service restart"
    elif [ "$OS" = darwin ] && launchctl list dev.offdesk.node >/dev/null 2>&1; then
        say ""
        say "The offdesk-node service is running an older binary. Restart it:"
        say "  offdesk-node service restart"
    fi
}

say() { printf '%s\n' "$1"; }
die() { printf 'error: %s\n' "$1" >&2; exit 1; }

main "$@"
