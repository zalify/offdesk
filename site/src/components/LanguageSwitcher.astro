---
// The language menu in the header: the same page in every other language.
// A <details>, so it works without JavaScript; Site.astro's script only
// closes it on an outside click or Escape. No redirect by Accept-Language:
// crawlers and people both land on the URL they asked for.
import { t, locales, localeInfo, pageUrl, origin, type Locale, type Page } from "../i18n";

interface Props {
  page: Page;
  locale: Locale;
}
const { page, locale } = Astro.props;
const { chrome } = t(locale);
const current = localeInfo(locale);
---

<details class="lang-menu relative" data-menu>
  <summary
    class="flex h-[34px] cursor-pointer list-none items-center gap-1.5 rounded-[4px] px-1 font-mono text-[13px] text-muted hover:text-accent"
    aria-label={chrome.languageLabel.replace("{name}", current.name)}
  >
    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
      <circle cx="12" cy="12" r="9" />
      <path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9M12 3C9.5 5.6 8.2 8.6 8.2 12s1.3 6.4 3.8 9" />
    </svg>
    <span>{current.code}</span>
    <span class="lang-caret text-subtle" aria-hidden="true">▾</span>
  </summary>
  <ul class="absolute right-0 z-30 mt-2 flex min-w-[11rem] flex-col rounded-[6px] border border-line bg-surface py-1.5 font-mono text-[13px] shadow-[0_8px_24px_rgba(0,0,0,0.5)]">
    {locales.map((l) => (
      <li>
        <a
          href={pageUrl(page, l.code).slice(origin.length)}
          hreflang={l.htmlLang}
          lang={l.htmlLang}
          aria-current={l.code === locale ? "true" : undefined}
          class:list={[
            "flex items-center justify-between gap-4 px-3.5 py-1.5 no-underline",
            l.code === locale ? "text-accent" : "text-muted hover:bg-surface-2 hover:text-text",
          ]}
        >
          <span>{l.name}</span>
          <span class="text-[12px] text-subtle">{l.code}</span>
        </a>
      </li>
    ))}
  </ul>
</details>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
  details[open] .lang-caret {
    display: inline-block;
    transform: rotate(180deg);
  }
</style>
