---
// The Mac setup guide, in any language. Words in src/i18n/<lang>.ts; the
// screenshots, the command and the step order are the same in every one.
import Site from "../layouts/Site.astro";
import { t, localize, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { mac: c } = t(locale);

type StepId = keyof typeof c.steps;
const order: { id: StepId; image?: string; command?: string }[] = [
  { id: "install", image: "install" },
  { id: "choose" },
  { id: "ready" },
  { id: "terminal", image: "terminal", command: "echo hello from offdesk" },
  { id: "phone", image: "phone-pairing" },
  { id: "return" },
  { id: "cloud" },
];
const figures: Record<string, { width: number; height: number }> = {
  install: { width: 616, height: 291 },
  terminal: { width: 802, height: 534 },
  "phone-pairing": { width: 428, height: 489 },
};
// "1. Install the Mac app" -> number "1", heading "Install the Mac app".
const split = (title: string) => {
  const m = title.match(/^(\d+)\.\s*(.*)$/);
  return m ? { n: m[1], text: m[2] } : { n: "", text: title };
};
const steps = order.map((o) => {
  const s = c.steps[o.id] as { title: string; body: string; extra: string; checks?: string[]; alt?: string; caption?: string; after?: string };
  return { ...o, ...s, ...split(s.title) };
});
const repo = "https://github.com/zalify/offdesk";
---
<Site title={`${c.title} · Offdesk`} description={c.description} page="mac" locale={locale}>
  <div class="wrap guide-layout pt-10 pb-20 md:pt-12">
    <aside class="guide-toc">
      <nav aria-label={c.contents}>
        <p class="toc-title">{c.contents}</p>
        <ol>{steps.map((s) => <li><a href={`#${s.id}`}><span class="toc-n">{s.n}</span><span set:html={s.text} /></a></li>)}</ol>
      </nav>
    </aside>
    <article class="doc guide min-w-0">
      <span class="label">{c.eyebrow}</span>
      <div class="prompt mt-5">docs/getting-started --mac</div>
      <h1 class="display mt-3 text-[34px] leading-[40px] md:text-[44px] md:leading-[50px]" set:html={c.title} />
      <p class="prose-lead mt-4" set:html={c.lead} />
      <div class="guide-actions"><a href="/mac" class="btn-primary">{c.download}</a><a href={localize("/#download", locale)} class="btn">{c.phone}</a></div>
      <aside class="version-note"><strong set:html={c.preview} /><p set:html={c.previewText} /></aside>
      <h2 set:html={c.before} /><ul>{c.needs.map((n) => <li set:html={n} />)}</ul><p set:html={c.terms} />
      {steps.map((s) => <section aria-labelledby={s.id}>
        {s.n && <p class="step-label">{c.stepLabel.replace("{n}", s.n)}</p>}
        <h2 id={s.id}>{s.n ? <span class="sr-only">{s.n}. </span> : null}<Fragment set:html={s.text} /></h2><p set:html={s.body}/>
        {s.checks && <ul class="checks">{s.checks.map((check) => <li set:html={check} />)}</ul>}
        <p set:html={s.extra}/>
        {s.command && <pre><code>{s.command}</code></pre>}
        {s.image && <figure class:list={["screenshot", { portrait: s.image === "phone-pairing" }]}>
          <a href={`/media/first-install/${s.image}.webp`} aria-label={c.openScreenshot}>
            <img src={`/media/first-install/${s.image}.webp`} {...figures[s.image]} alt={s.alt} loading="lazy" decoding="async"/>
          </a><figcaption set:html={s.caption} />
        </figure>}
        {s.after && <p set:html={s.after} />}
      </section>)}
      <h2 id="troubleshooting" set:html={c.trouble} />
      <div class="faqs">{c.faqs.map(([question, answer]) => <details class="faq"><summary set:html={question} /><p set:html={answer} /></details>)}</div>
      <details class="acceptance"><summary set:html={c.tested} /><p set:html={c.testedIntro} /><ul>{c.passed.map((x) => <li set:html={x} />)}</ul><p set:html={c.pending} /><p set:html={c.known} /></details>
      <h2 set:html={c.next} /><p set:html={c.nextText} /><ul>
        <li><a href={`${repo}/blob/main/docs/encrypted-connections.md`} set:html={c.encryption} /></li>
        <li><a href={`${repo}/blob/main/docs/setup-lan.md`} set:html={c.lan} /></li>
        <li><a href={`${repo}#readme`} set:html={c.allDocs} /></li>
      </ul>
    </article>
  </div>
</Site>
<style>
  .guide-layout{display:flex;flex-wrap:wrap;gap:48px}
  .guide-toc{flex:1 1 220px;font-family:var(--font-mono);font-size:13px}
  .guide-toc nav{position:sticky;top:24px}
  .guide{flex:999 1 560px;max-width:760px}
  .toc-title{font-size:12px;font-weight:500;color:var(--color-subtle);margin-bottom:8px}
  .guide-toc ol{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:8px}
  .guide-toc a{display:flex;gap:10px;color:var(--color-muted);text-decoration:none;line-height:20px}
  .guide-toc a:hover{color:var(--color-accent)}
  .toc-n{color:var(--color-subtle);min-width:1ch}
  .guide-toc a:hover .toc-n{color:var(--color-accent)}
  .guide-actions{display:flex;align-items:center;flex-wrap:wrap;gap:12px;margin:24px 0 28px}
  .guide :global(a.btn-primary),.guide :global(a.btn){text-decoration:none}.guide :global(a.btn-primary){color:var(--color-on-accent)}.guide :global(a.btn){color:var(--color-text)}
  .step-label{margin-top:48px;padding-top:24px;border-top:1px solid var(--color-line);font-family:var(--font-mono);font-size:12px;font-weight:500;color:var(--color-accent)}
  .step-label + h2{margin-top:8px;padding-top:0;border-top:0}
  .guide :global(h2[id]){scroll-margin-top:24px}
  .version-note{padding:14px 16px;border:1px solid var(--color-line);border-radius:4px;background:var(--color-surface);margin-top:8px}
  .version-note strong{font-family:var(--font-mono);font-size:13px;font-weight:600}
  .version-note p{margin-top:6px;font-size:15px;line-height:23px}
  .checks{padding:4px 16px 14px 36px;border:1px solid var(--color-line);border-left:2px solid var(--color-accent);background:var(--color-surface);border-radius:0 4px 4px 0;margin-top:16px}
  .screenshot{margin:24px 0 0}.screenshot img{display:block;width:100%;height:auto;border:1px solid var(--color-line);border-radius:6px;background:var(--color-surface)}.screenshot.portrait{max-width:460px;margin-left:auto;margin-right:auto}
  figcaption{color:var(--color-subtle);font-family:var(--font-sans);font-size:14px;line-height:1.6;margin-top:12px}
  .faqs{margin-top:16px;border:1px solid var(--color-line);border-radius:6px;overflow:hidden}
  .faq{padding:0 16px}.faq + .faq{border-top:1px solid var(--color-line)}.faq p{margin:0 0 16px}
  summary{display:flex;gap:12px;padding:14px 0;cursor:pointer;color:var(--color-text);font-family:var(--font-mono);font-size:14px;line-height:1.6;list-style:none}
  summary::-webkit-details-marker{display:none}
  summary::after{content:"[+]";margin-left:auto;color:var(--color-subtle);flex-shrink:0}
  details[open]>summary::after{content:"[−]"}
  .acceptance{margin-top:24px;padding:0 16px 4px;border:1px solid var(--color-line);border-radius:6px;background:var(--color-surface)}
  .guide code{overflow-wrap:anywhere}
  @media(max-width:860px){.guide-toc nav{position:static}.guide-toc{padding:14px 16px;border:1px solid var(--color-line);border-radius:6px;background:var(--color-surface);order:0}}
  @media(max-width:600px){.guide-actions{align-items:stretch}.guide-actions a{flex:1 1 180px}.screenshot img{border-radius:4px}}
</style>
