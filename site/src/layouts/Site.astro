---
// The frame every page shares: fonts, nav, footer, the sun in the corner.
import "@fontsource-variable/fredoka";
import "@fontsource-variable/nunito";
import "@fontsource/geist-mono/400.css";
import "@fontsource/geist-mono/500.css";
import "../styles/global.css";
import Icon from "../components/Icon.astro";

interface Props {
  title: string;
  description: string;
  path?: string;
  lang?: "en" | "zh-CN";
}
const { title, description, path = "/", lang = "en" } = Astro.props;
const repo = "https://github.com/zalify/offdesk";
const discord = "https://discord.gg/aFUu6VMzc";
const canonical = `https://offdesk.dev${path}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!-- The donut. The query string is a cache key: browsers hold on to a
         favicon long after the file behind it changed. -->
    <link rel="icon" href="/favicon.svg?v=donut" type="image/svg+xml" />
    <link rel="icon" href="/brand/favicon-32.png?v=donut" sizes="32x32" type="image/png" />
    <link rel="icon" href="/brand/favicon-16.png?v=donut" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png?v=donut" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#fff4e3" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://offdesk.dev/brand/og-square.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://offdesk.dev/brand/og-square.png" />
  </head>

  <body class="relative min-h-screen overflow-x-hidden">
    <!-- The sun: one big soft disc behind the top of every page. -->
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -top-40 -right-32 h-[34rem] w-[34rem] rounded-full bg-sun/50 blur-3xl"
    ></div>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-[42rem] -left-40 h-[26rem] w-[26rem] rounded-full bg-lagoon/25 blur-3xl"
    ></div>

    <header class="relative z-10">
      <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5">
        <a href="/" aria-label="offdesk home" class="flex items-center gap-2.5">
          <!-- The mark: a coral donut with sprinkles. -->
          <svg width="34" height="34" viewBox="0 0 34 34" aria-hidden="true">
            <circle cx="17" cy="17" r="10" fill="none" stroke="#ff6b57" stroke-width="9" />
            <g stroke-width="2.6" stroke-linecap="round">
              <path d="M10 8.5l3.2-2.2" stroke="#38b6e3" />
              <path d="M24.5 9.5l2.6 2.6" stroke="#ff8fb1" />
              <path d="M6 20l-1.2 3.4" stroke="#ffc857" />
              <path d="M22 28.4l3.6 0.6" stroke="#5ed3c1" />
              <path d="M14.5 30l-2.8 1.6" stroke="#ff8fb1" />
            </g>
          </svg>
          <span class="font-display text-[26px] font-bold tracking-[-0.02em] text-ink">offdesk</span>
        </a>
        <div class="hidden items-center gap-7 md:flex">
          <a href="/#download" class="font-display text-[15px] font-semibold text-ink-2 hover:text-coral">Download</a>
          <a href="/#how" class="font-display text-[15px] font-semibold text-ink-2 hover:text-coral">How it works</a>
          <a href="/#away" class="font-display text-[15px] font-semibold text-ink-2 hover:text-coral">Away from home</a>
          <a href="/docs/mac" class="font-display text-[15px] font-semibold text-ink-2 hover:text-coral">Docs</a>
          <a href="/#agents" class="font-display text-[15px] font-semibold text-ink-2 hover:text-coral">For agents</a>
        </div>
        <div class="flex items-center gap-2">
          <a href={discord} class="btn-sky px-4 py-2 text-[14px]" aria-label="offdesk on Discord">
            <Icon name="discord" /><span class="hidden sm:inline">Discord</span>
          </a>
          <a href={repo} class="btn-coral px-4 py-2 text-[14px]" aria-label="offdesk on GitHub">
            <Icon name="github" /><span class="hidden sm:inline">GitHub</span>
          </a>
        </div>
      </nav>
    </header>

    <main class="relative z-10">
      <slot />
    </main>

    <footer class="relative z-10 mt-10 border-t border-line">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-6 py-8">
        <span class="font-display text-[14px] font-semibold text-muted">
          MIT · made by <a href="https://zalify.com" class="text-ink hover:text-coral">Zalify</a> · go outside
        </span>
        <span class="flex items-center gap-6 font-display text-[14px] font-semibold text-muted">
          <a href="/docs/mac" class="hover:text-coral">Getting started</a>
          <a href="/tunnel" class="hover:text-coral">Tunnel guide</a>
          <a href={`${repo}/blob/main/SECURITY.md`} class="hover:text-coral">Security</a>
          <a href={discord} class="inline-flex items-center gap-1.5 hover:text-coral"><Icon name="discord" /> Discord</a>
          <a href={repo} class="inline-flex items-center gap-1.5 hover:text-coral"><Icon name="github" /> GitHub</a>
        </span>
      </div>
    </footer>

    <script is:inline>
      for (const button of document.querySelectorAll("[data-copy]")) {
        button.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(button.dataset.copy);
            button.textContent = "Copied";
          } catch {
            button.textContent = "Press ⌘C";
          }
          setTimeout(() => {
            button.textContent = "Copy";
          }, 1600);
        });
      }
    </script>
  </body>
</html>
