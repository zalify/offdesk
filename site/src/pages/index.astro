---
import { existsSync } from "node:fs";
import Site from "../layouts/Site.astro";
import Icon from "../components/Icon.astro";

// The hero GIF is not committed yet (see docs/media/README.md). Until it is,
// a real phone screenshot stands in; the GIF wins when it appears.
const hasHero = existsSync(new URL("../../public/media/hero.gif", import.meta.url));
const hasStill = existsSync(new URL("../../public/media/phone-terminal.png", import.meta.url));
// The iPhone app, once its screenshot is in: same terminal, native frame.
const hasIphone = existsSync(new URL("../../public/media/phone-ios.jpg", import.meta.url));

const repo = "https://github.com/zalify/offdesk";
const discord = "https://discord.gg/aFUu6VMzc";
const docs = "/docs/mac";
// /apk redirects to the newest app-v* release — see site/worker.js.
const apk = "https://offdesk.dev/apk";
const ios = "https://testflight.apple.com/join/rV4ktaGv";
const title = "Offdesk — One terminal, shared by you and your agents";
const description =
  "One terminal, shared by you and your agents. Agents open, type into and read terminals through the CLI; you watch the same ones from your phone and take the keyboard when they need you. Self-hosted remote terminal for Claude Code, Codex and anything in tmux. MIT licensed.";
const install = "curl -fsSL https://offdesk.dev/install | sh";

const tunnel = [
  "git clone https://github.com/zalify/offdesk && cd offdesk",
  "$EDITOR .env   # OFFDESK_BASE_URL, TUNNEL_TOKEN, OAuth",
  "docker compose --profile tunnel up -d --build",
].join("\n");

const join = [
  "curl -fsSL https://offdesk.dev/install \\",
  "  | sh -s -- --hub-url ws://192.168.1.10:4317/ws/machine \\",
  "  --token <token>",
].join("\n");

const orchestration = `T=$(offdesk open nas --cwd ~/app --cmd claude --json | jq -r .id)
offdesk send $T \\
  "fix the type errors in src/auth.ts; stop when tests pass"
offdesk wait $T --silence 5000 --timeout 600
offdesk read $T --lines 80`;

const agents = [
  "Claude Code",
  "Codex",
  "OpenCode",
  "Gemini CLI",
  "Aider",
  "vim",
  "htop",
  "pnpm dev",
  "any CLI",
];

// Every cell is from the vendor's own documentation, checked 2026-09-01.
// Sources are in README.md, under the same table.
const columns = [
  "Any terminal program",
  "Machines per hub",
  "Traffic goes through",
  "Agents can drive it via CLI",
  "Self-hosted",
];
const rows = [
  { name: "Offdesk", self: true, cells: ["Anything that runs in tmux", "Any number, one URL", "Your own hub", "open / send / wait / read", "Yes, MIT"] },
  { name: "Claude Code Remote Control", cells: ["No — a Claude Code session, not a terminal", "Sessions from several machines in one list", "Anthropic's servers; transcript stored there", "Not documented", "No"] },
  { name: "VibeTunnel", cells: ["Yes — vt <any command>, vt --shell", "One server per machine", "Your choice: LAN, Tailscale, ngrok, Cloudflare", "Launches commands only", "Yes, MIT"] },
  { name: "Happy Coder", cells: ["No — wraps claude and codex", "Several; spawn --machine", "slopus cloud by default, end-to-end encrypted", "create / send / history / wait", "Optional, MIT"] },
  { name: "Omnara", cells: ["Agent sessions; no raw terminal documented", "Several at once per agent", "api.omnara.com by default", "CLI and REST", "Optional, Apache-2.0"] },
  { name: "Orca", cells: ["Yes — real terminal, 30+ CLI agents", "Several, via SSH worktrees and orca serve", "Orca Relay by default, or direct on the LAN", "orca terminal create/send/read/wait", "Yes, MIT"] },
];

// The proof strip under the hero: Offdesk's own row of the table above.
const proof = [
  { key: "any-program", value: "anything that runs in tmux" },
  { key: "machines", value: "any number, one url" },
  { key: "traffic", value: "through your own hub" },
  { key: "agents", value: "open · send · wait · read" },
  { key: "license", value: "self-hosted, MIT" },
];

const beats = [
  {
    label: "01 / agent",
    title: "your agent opens it",
    body: "One command starts Claude Code, Codex or anything else in a terminal on any machine you own. It keeps running when everyone walks away.",
  },
  {
    label: "02 / you",
    title: "you watch the same one",
    body: "Not a transcript: the live terminal, on your phone, laptop or a browser. When it stops to ask, you see it.",
  },
  {
    label: "03 / either",
    title: "take control, hand it back",
    body: "Answer with Enter, or take the keyboard. In the agent's browser too: sign in for it, then hand it back.",
  },
];
---

<Site title={title} description={description}>
  <!-- Hero: the claim, the two ways in, and the picture of the claim. -->
  <section class="wrap flex flex-wrap items-center gap-12 pt-12 pb-14 md:pt-[72px]">
    <div class="flex min-w-0 flex-[999_1_480px] flex-col gap-6">
      <p class="prompt">offdesk --about <span class="text-subtle"># open source · tmux · websocket</span></p>
      <h1 class="display text-[36px] leading-[42px] sm:text-[46px] sm:leading-[52px] lg:text-[56px] lg:leading-[62px]">
        One terminal, shared by you and your agents.<span class="cursor" aria-hidden="true"></span>
      </h1>
      <p class="prose-lead max-w-[560px]">
        Agents open, type into and read terminals through the CLI. You watch
        the same ones from your phone, and take the keyboard when they need you.
      </p>
      <div class="flex flex-wrap gap-2.5">
        <a href="/mac" class="btn-primary btn-lg">download for mac</a>
        <a href="#download" class="btn btn-lg">all downloads</a>
      </div>
      <div class="flex flex-col gap-2">
        <div class="cmd self-start">
          <pre><code><span class="cmd-prompt">$ </span>{install}</code></pre>
          <button type="button" class="cmd-copy" data-copy={install} aria-label="Copy the install command">[copy]</button>
        </div>
        <p class="font-sans text-[13px] text-subtle">
          The Mac app is signed and notarized, for Apple silicon and Intel. The
          one-liner installs the hub on macOS or Linux.
        </p>
      </div>
    </div>

    <figure class="flex min-w-0 flex-[1_1_520px] flex-col gap-3">
      <div class="term overflow-hidden">
        <div class="grid grid-cols-1 sm:grid-cols-2">
          <div class="flex flex-col border-b border-line sm:border-r">
            <div class="border-b border-line px-3 py-2 text-[11px] font-medium text-subtle">agent@laptop</div>
            <div class="flex flex-col gap-0.5 px-3 py-3.5 text-[11.5px] leading-[19px]">
              <div><span class="text-accent">$</span> T=$(offdesk open nas \</div>
              <div class="pl-3.5">--cwd ~/app --cmd claude \</div>
              <div class="pl-3.5">--json | jq -r .id)</div>
              <div><span class="text-accent">$</span> offdesk send $T \</div>
              <div class="pl-3.5 text-muted">"fix the type errors in</div>
              <div class="pl-3.5 text-muted">&nbsp;src/auth.ts; stop when</div>
              <div class="pl-3.5 text-muted">&nbsp;tests pass"</div>
              <div><span class="text-accent">$</span> offdesk wait $T --silence 5000</div>
              <div class="text-subtle">waiting…</div>
            </div>
          </div>
          <div class="flex flex-col border-b border-line sm:border-b-0">
            <div class="flex justify-between gap-2 border-b border-line px-3 py-2 text-[11px] font-medium text-subtle">
              <span>you@phone</span><span class="text-accent">● same terminal</span>
            </div>
            <div class="flex min-h-[300px] flex-1 flex-col gap-0.5 px-3 py-3.5 text-[11.5px] leading-[19px] sm:min-h-[340px]">
              <div class="text-subtle">┌ claude · ~/app · nas</div>
              <div class="my-1 inline-flex items-center gap-1.5 self-start rounded-[3px] border border-control px-1.5 text-[10.5px] text-muted">
                <span class="text-accent" aria-hidden="true">⌁</span>opened by agent · cli
              </div>
              <div class="text-subtle">&gt; fix the type errors…</div>
              <div>● Edited src/auth.ts (+6 −3)</div>
              <div>● Bash pnpm install</div>
              <div class="mt-1.5 text-waiting">? Allow network access</div>
              <div class="text-waiting">&nbsp;&nbsp;for npm install?</div>
              <div class="text-subtle">❯ 1. Yes&nbsp;&nbsp;2. No</div>
              <div class="grow"></div>
              <div class="mt-3 grid grid-cols-2 gap-1.5" aria-hidden="true">
                <span class="flex h-[34px] items-center justify-center rounded-[4px] border border-control text-[12px] font-medium">[enter]</span>
                <span class="flex h-[34px] items-center justify-center rounded-[4px] bg-accent text-[12px] font-semibold text-on-accent">take control</span>
              </div>
            </div>
          </div>
        </div>
      </div>
      <figcaption class="font-sans text-[12.5px] text-subtle">
        An illustration: one terminal, opened by an agent with the CLI and
        watched from a phone.
      </figcaption>
    </figure>
  </section>

  <!-- Proof: Offdesk's own row of the comparison table further down. -->
  <section aria-label="At a glance" class="border-y border-line">
    <ul class="wrap grid grid-cols-1 font-mono text-[13px] sm:grid-cols-2 lg:grid-cols-5">
      {proof.map((p, i) => (
        <li class:list={[
          "flex flex-col gap-1 py-4 lg:py-[18px]",
          i > 0 && "border-t border-line sm:border-t-0",
          i % 2 === 1 && "sm:border-l sm:pl-4",
          i >= 2 && "sm:border-t lg:border-t-0",
          i > 0 && "lg:border-l lg:pl-4",
        ]}>
          <span class="text-accent">{p.key}</span>
          <span class="text-muted">{p.value}</span>
        </li>
      ))}
    </ul>
  </section>

  <!-- Three beats: who does what with the one terminal. -->
  <section class="wrap flex flex-col gap-7 py-16 md:py-[72px]">
    <h2 class="h2">Whoever needs the keyboard takes it.</h2>
    <ol class="cells grid-cols-1 md:grid-cols-3">
      {beats.map((b) => (
        <li class="flex flex-col gap-2.5 p-6">
          <span class="label">{b.label}</span>
          <h3 class="h3">{b.title}</h3>
          <p class="prose-body">{b.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- First setup, on the machine at home. -->
  <section id="start" class="border-t border-line">
    <div class="wrap flex flex-col gap-6 py-16 md:py-[72px]">
      <p class="prompt">get-started</p>
      <h2 class="h2">Your first terminal in three steps.</h2>
      <ol class="cells grid-cols-1 lg:grid-cols-3">
        <li class="flex min-w-0 flex-col gap-3 p-6">
          <span class="label">step 1</span>
          <h3 class="h3">Install the hub on macOS or Linux</h3>
          <p class="prose-body">
            Open the Mac app, say this is the machine that stays on, and it
            becomes your hub: runs at login, restarts if it stops.
            Self-hosting needs no vendor account. On a NAS or a server with no
            screen, one line does the same:
          </p>
          <div class="cmd">
            <pre><code><span class="cmd-prompt">$ </span>{install}</code></pre>
            <button type="button" class="cmd-copy" data-copy={install} aria-label="Copy the install command">[copy]</button>
          </div>
        </li>
        <li class="flex min-w-0 flex-col gap-3 p-6">
          <span class="label">step 2</span>
          <h3 class="h3">Pair your phone or sign in from a browser</h3>
          <p class="prose-body">
            Choose Offdesk App to generate an encrypted pairing code for the
            in-app scanner. Choose Browser access for a browser sign-in link.
            Find both in the Mac menu bar, or run
            <span class="inline-code">offdesk link</span> for browser access.
          </p>
        </li>
        <li class="flex min-w-0 flex-col gap-3 p-6">
          <span class="label">step 3</span>
          <h3 class="h3">Reconnect to the same tmux session</h3>
          <p class="prose-body">
            Same tmux session as the desk, live. Keep the hub awake and online.
            Anything that runs in tmux runs here.
          </p>
        </li>
      </ol>
      <div class="flex flex-wrap gap-2.5">
        <a href={docs} class="btn-primary">read the mac guide</a>
        <a href={ios} class="btn">iphone app</a>
        <a href={apk} class="btn">android app</a>
        <span class="self-center font-sans text-[13px] text-subtle">or any browser on the phone</span>
      </div>
    </div>
  </section>

  <!-- Download: every client, one place -->
  <section id="download" class="border-y border-line bg-surface">
    <div class="wrap flex flex-col gap-6 py-16">
      <p class="prompt">download</p>
      <h2 class="h2">Clients for desktop, phone and the web.</h2>
      <p class="prose-lead max-w-2xl">
        The desktop app is the hub on a Mac, and a client everywhere. The phone
        apps wrap the same terminal the browser shows.
      </p>
      <div class="grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-3">
        <div class="panel flex flex-col gap-3 p-5">
          <h3 class="font-mono text-[15px] font-semibold">macOS</h3>
          <p class="prose-body grow">
            One dmg for Apple silicon and Intel. Signed with a Developer ID and
            notarized, so it opens like anything from the App Store. On the Mac
            that stays on it becomes your hub; anywhere else it is a client.
          </p>
          <a href="/mac" class="btn-primary self-start">download .dmg →</a>
          <p class="font-mono text-[12px] text-subtle">macOS 11 or later · universal · .dmg</p>
        </div>
        <div class="panel flex flex-col gap-3 p-5">
          <h3 class="font-mono text-[15px] font-semibold">Windows</h3>
          <p class="prose-body grow">
            A client: it opens the terminals on a hub somewhere else. Paste the
            link the hub printed, or sign in. A Windows machine cannot be the
            hub, which needs tmux.
          </p>
          <a href="/windows" class="btn self-start">download .msi →</a>
          <p class="font-mono text-[12px] text-subtle">x64 · .msi</p>
        </div>
        <div class="panel flex flex-col gap-3 p-5">
          <h3 class="font-mono text-[15px] font-semibold">Linux</h3>
          <p class="prose-body grow">
            A client, as on Windows. For a Linux box that should be the hub,
            the one-line install is the way: it runs the hub as a service.
          </p>
          <a href="/linux" class="btn self-start">download .AppImage →</a>
          <p class="font-mono text-[12px] text-subtle">x64 · .AppImage · .deb and .rpm on <a href="/desktop" class="text-text underline decoration-accent/60 underline-offset-4 hover:text-accent">the release page</a></p>
        </div>
        <div class="panel flex flex-col gap-3 p-5">
          <h3 class="font-mono text-[15px] font-semibold">iPhone</h3>
          <p class="prose-body grow">
            Available through TestFlight. Open the invitation on your iPhone or
            iPad, install the app, then choose Scan QR Code to connect to your hub.
          </p>
          <a href={ios} class="btn self-start">join the beta →</a>
        </div>
        <div class="panel flex flex-col gap-3 p-5">
          <h3 class="font-mono text-[15px] font-semibold">Android</h3>
          <p class="prose-body grow">
            An APK to sideload. Take <span class="inline-code">arm64-v8a</span> on
            a modern phone, <a href="/apk/universal">universal</a> if unsure.
          </p>
          <a href={apk} class="btn self-start">download apk →</a>
        </div>
        <div class="panel flex min-w-0 flex-col gap-3 p-5">
          <h3 class="font-mono text-[15px] font-semibold">Hub, node and CLI</h3>
          <p class="prose-body grow">
            The three binaries, for a NAS, a VPS, or any machine without a
            screen. Linux and macOS, x64 and arm64.
          </p>
          <div class="cmd">
            <pre><code><span class="cmd-prompt">$ </span>{install}</code></pre>
            <button type="button" class="cmd-copy" data-copy={install} aria-label="Copy the install command">[copy]</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section id="how" class="wrap flex flex-col gap-6 py-16">
    <p class="prompt">how-it-works</p>
    <h2 class="h2">Rust hub. Outbound WebSockets. Persistent tmux.</h2>
    <ol class="cells grid-cols-1 lg:grid-cols-3">
      <li class="flex flex-col gap-2.5 p-6">
        <span class="label">01</span>
        <h3 class="h3">hub</h3>
        <p class="prose-body grow">
          A Rust server built with Axum, SQLite storage, and an embedded web
          UI. It authenticates clients and routes terminal traffic to your
          macOS and Linux nodes. Install a binary or deploy with Docker.
        </p>
        <code class="font-mono text-[12px] text-subtle">offdesk-hub</code>
      </li>
      <li class="flex flex-col gap-2.5 p-6">
        <span class="label">02</span>
        <h3 class="h3">node</h3>
        <p class="prose-body grow">
          On every machine you want to reach. It dials <em>out</em> to the
          hub over WebSocket, so the node needs no inbound port or public
          IP. Every terminal is a tmux session on the machine that owns it:
          it outlives the app, the network, and you walking away. Uninstall
          Offdesk and it's still there.
        </p>
        <code class="font-mono text-[12px] text-subtle">offdesk-node · tmux</code>
      </li>
      <li class="flex flex-col gap-2.5 p-6">
        <span class="label">03</span>
        <h3 class="h3">client</h3>
        <p class="prose-body grow">
          React and xterm.js render the interactive terminal in the browser.
          Tauri apps add native encrypted pairing on desktop and mobile.
          The Rust CLI provides scriptable access. Clients share terminal
          output through the Hub; a control lease determines who can type.
        </p>
        <code class="font-mono text-[12px] text-subtle">browser · phone · desktop · offdesk</code>
      </li>
    </ol>
    <p class="prose-body max-w-2xl">
      Two screens on one terminal are two clients of one hub, attached to
      one tmux session. Client disconnects do not terminate the session on
      the node. Offdesk uses its own Hub/node transport, not SSH: install
      offdesk-node on each machine you want to reach.
    </p>
  </section>

  <!-- Away from home: deployment, encryption, the tunnel -->
  <section id="away" class="border-y border-line bg-surface">
    <div class="wrap flex flex-col gap-10 py-16">
      <div class="flex flex-wrap items-start gap-x-12 gap-y-8">
        <div class="flex min-w-0 flex-[999_1_420px] flex-col gap-4">
          <p class="prompt">remote-access</p>
          <h2 class="h2">Self-host on your LAN. Add remote access when you need it.</h2>
          <p class="prose-body">
            Run the open-source Hub on macOS, Linux, a NAS, or a VPS. Nodes connect
            outbound to that Hub; terminal sessions stay on the machines running
            tmux. Your Hub and those machines must remain awake and online.
          </p>
          <p class="prose-body">
            Run cloudflared next to your Hub to expose an HTTPS endpoint without
            opening a router port, including behind NAT or CGNAT. Configure your
            domain and tunnel ingress, or use
            <a href={`${repo}/blob/main/docs/setup-public.md#tailscale`}>Tailscale</a>
            for private access to the Hub across your devices.
          </p>
          <p class="prose-body">
            Paired Offdesk Apps encrypt terminal traffic end to end between the
            App and Hub, including through a tunnel. Ordinary browser access uses
            HTTPS and its own authentication, which the tunnel provider
            terminates; it does not automatically gain App encryption. See the
            <a href={`${repo}/blob/main/docs/encrypted-connections.md`}>encrypted connection guide</a>.
          </p>
          <div class="flex flex-wrap gap-2.5 pt-2">
            <a href="/tunnel" class="btn-primary">the tunnel guide</a>
            <a href={`${repo}/blob/main/docs/setup-lan.md`} class="btn">lan setup</a>
            <a href={`${repo}/blob/main/docs/encrypted-connections.md`} class="btn">encrypted app pairing</a>
            <a href={`${repo}/blob/main/docs/managed-connections.md`} class="btn">cloud setup</a>
          </div>
        </div>
        <div class="flex min-w-0 flex-[1_1_380px] flex-col gap-4">
          <div class="panel flex min-w-0 flex-col gap-3 p-5">
            <h3 class="font-mono text-[14px] font-semibold"># on the machine at home</h3>
            <p class="prose-body">
              Create the tunnel in Cloudflare's dashboard, point it at
              <span class="inline-code">server:4317</span>, drop its token in
              <span class="inline-code">.env</span>, and:
            </p>
            <div class="cmd">
              <pre><code>{tunnel.split("\n").map((line) => (<span class="block"><span class="cmd-prompt">$ </span>{line}</span>))}</code></pre>
              <button type="button" class="cmd-copy" data-copy={tunnel} aria-label="Copy the tunnel commands">[copy]</button>
            </div>
            <p class="prose-body">
              For encrypted App access, scan the encrypted pairing code with the
              App's scanner. For ordinary browser access, configure authentication
              as described in the tunnel guide.
            </p>
          </div>
          <div class="panel flex flex-col gap-2 p-5">
            <h3 class="font-mono text-[14px] font-semibold">offdesk cloud <span class="ml-1 rounded-[3px] border border-control px-1.5 py-0.5 text-[11px] font-medium text-muted">invite-only beta</span></h3>
            <p class="prose-body">
              Optional Offdesk Cloud offers managed remote access. Its service is
              closed source; the Hub, node, CLI, and clients in the public
              repository remain MIT licensed. The local connector checks
              encrypted reachability and automatically retries sustained tunnel
              failures with backoff. Local use needs no Cloud account.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- More: other machines, the phone, any agent -->
  <section id="more" class="wrap flex flex-col gap-6 py-16">
    <p class="prompt">more</p>
    <h2 class="h2">Remote shells, mobile coding agents, and CLI automation.</h2>
    <div class="grid grid-cols-1 gap-3 lg:grid-cols-2">
      <div class="panel flex min-w-0 flex-col gap-3 p-6">
        <h3 class="h3">Manage macOS and Linux terminals</h3>
        <p class="prose-body">
          The NAS, the VPS, the laptop. Open the hub, choose <strong>Add
          a machine</strong>, and it hands you one line with a token in it. Paste it
          on that machine; it shows up.
        </p>
        <pre class="term overflow-x-auto px-4 py-3 text-[12.5px]"><code>{join}</code></pre>
      </div>
      <div class="panel flex min-w-0 flex-col gap-3 p-6">
        <h3 class="h3">Bring any agent</h3>
        <p class="prose-body">
          Offdesk doesn't wrap an agent or speak its protocol. It hands you the
          terminal the agent already runs in — your subscription, your config,
          your dotfiles.
        </p>
        <ul class="flex flex-wrap gap-2">
          {agents.map((a) => (<li class:list={["chip", a === "any CLI" && "text-accent"]}>{a}</li>))}
        </ul>
      </div>
    </div>

    <div id="phone" class="panel flex flex-wrap items-center gap-x-10 gap-y-8 p-6 md:p-8">
      <div class="flex min-w-0 flex-[999_1_420px] flex-col gap-4">
        <h3 class="h3">Use Claude Code and Codex from your phone</h3>
        <p class="prose-body">
          Customize the key bar with Esc, Tab, Shift+Tab, Shift combinations
          and Backspace repeat. Arrows, Enter and the keyboard toggle stay
          fixed; hide or reorder the other keys in Settings.
          <a href={`${repo}/blob/main/docs/terminal-keys.md`}>Configure terminal keys</a>. The apps add a QR scanner and end-to-end
          encrypted connections.
        </p>
        <p class="prose-body">
          A waiting banner lets you open another terminal's confirmation request
          or send Enter to its current selection while keeping your view.
          <a href={`${repo}/blob/main/docs/terminal-attention.md`}>Read about confirmation shortcuts</a>.
        </p>
        <p class="prose-body">
          <strong>iPhone and iPad:</strong> join the public TestFlight beta
          using the link below. TestFlight handles app updates.
        </p>
        <div class="flex flex-wrap gap-2.5">
          <a href={apk} class="btn-primary">android apk</a>
          <a href="https://offdesk.dev/apk/universal" class="btn">universal build</a>
          <a href={ios} class="btn">iphone · testflight</a>
        </div>
      </div>
      {
        hasHero ? (
          <figure class="min-w-0 flex-[1_1_360px] overflow-hidden rounded-[6px] border border-line">
            <img src="/media/hero.gif" alt="Claude Code on a desk machine while a phone is attached to the same tmux session" width="1200" height="750" loading="lazy" class="block w-full" />
          </figure>
        ) : hasIphone || hasStill ? (
          <figure class="mx-auto flex w-full max-w-[15rem] flex-[0_1_15rem] flex-col gap-3">
            <div class="overflow-hidden rounded-[2rem] border border-control bg-surface p-1.5">
              {hasIphone ? (
                <img src="/media/phone-ios.jpg" alt="Claude Code in the Offdesk iPhone app, attached to the Mac at home" width="1179" height="2556" loading="lazy" class="block w-full rounded-[1.6rem]" />
              ) : (
                <img src="/media/phone-terminal.png" alt="An Offdesk terminal on a phone: Claude Code on a Mac at home, attached from the phone's browser" width="390" height="844" loading="lazy" class="block w-full rounded-[1.6rem]" />
              )}
            </div>
            <figcaption class="text-center font-sans text-[13px] text-subtle">
              Claude Code in a persistent remote tmux session.
            </figcaption>
          </figure>
        ) : null
      }
    </div>
  </section>

  <!-- For agents -->
  <section id="agents" class="border-y border-line bg-surface">
    <div class="wrap flex flex-wrap items-start gap-x-12 gap-y-8 py-16">
      <div id="cli" class="flex min-w-0 flex-[999_1_360px] flex-col gap-4">
        <p class="prompt">for-agents</p>
        <h2 class="h2">Automate remote terminals with the Offdesk CLI.</h2>
        <p class="prose-lead">
          Use open, send, wait, and read commands to control remote tmux
          sessions from shell scripts or AI coding agents. JSON output lets
          your scripts capture terminal IDs and pass results between steps.
          A terminal an agent opens is marked as opened by an agent, so you
          can tell it apart from your own.
        </p>
        <p class="prose-body">
          A token is remote code execution on every machine you registered.
          Mint one per agent, name it, revoke it alone.
          <a href={`${repo}/blob/main/SECURITY.md`}>SECURITY.md</a>
        </p>
      </div>
      <div class="cmd min-w-0 flex-[1_1_440px] bg-bg">
        <pre class="text-[12.5px]"><code>{orchestration.split("\n").map((line) => (
          <span class="block">{line.startsWith(" ") ? line : (<><span class="cmd-prompt">$ </span>{line}</>)}</span>
        ))}</code></pre>
        <button type="button" class="cmd-copy" data-copy={orchestration} aria-label="Copy the example">[copy]</button>
      </div>
    </div>
  </section>

  <!-- Compare -->
  <section id="compare" class="wrap flex flex-col gap-5 py-16">
    <p class="prompt">compare</p>
    <h2 class="h2">How it compares</h2>
    <p class="prose-body max-w-2xl">
      Every cell is from that project's own documentation, checked
      2026-09-01. Sources are under the same table in the README.
    </p>
    <div class="overflow-x-auto rounded-[6px] border border-line">
      <table class="w-full min-w-[56rem] border-collapse text-left font-sans text-[14px]">
        <thead>
          <tr>
            <th scope="col" class="px-4 py-3"><span class="sr-only">Project</span></th>
            {columns.map((c) => <th scope="col" class="px-4 py-3 align-bottom font-mono text-[12.5px] font-medium text-subtle">{c}</th>)}
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr class:list={["border-t border-line", { "bg-surface-2": row.self }]}>
              <th scope="row" class:list={["px-4 py-3 align-top font-mono text-[13px] font-semibold", row.self ? "text-accent" : "text-text"]}>{row.name}</th>
              {row.cells.map((cell) => (
                <td class:list={["px-4 py-3 align-top leading-snug", /not documented/i.test(cell) ? "text-subtle" : row.self ? "text-text" : "text-muted"]}>{cell}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Close -->
  <section class="border-t border-line">
    <div class="wrap flex flex-col items-center gap-5 py-20 text-center">
      <h2 class="display text-[32px] leading-[38px] md:text-[44px] md:leading-[50px]">
        Set up your hub tonight.<span class="cursor" aria-hidden="true"></span>
      </h2>
      <p class="prose-lead max-w-xl">
        Install the Hub on macOS or Linux, register your machines, and open
        persistent tmux sessions from your browser or phone.
      </p>
      <div class="cmd max-w-full text-left">
        <pre><code><span class="cmd-prompt">$ </span>{install}</code></pre>
        <button type="button" class="cmd-copy" data-copy={install} aria-label="Copy the install command">[copy]</button>
      </div>
      <div class="flex flex-wrap justify-center gap-2.5">
        <a href={repo} class="btn-primary"><Icon name="github" />github ↗</a>
        <a href={discord} class="btn"><Icon name="discord" />discord</a>
        <a href={ios} class="btn">iphone app</a>
        <a href={apk} class="btn">android app</a>
      </div>
    </div>
  </section>
</Site>
