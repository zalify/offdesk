---
import { existsSync } from "node:fs";
import Site from "../layouts/Site.astro";
import Icon from "../components/Icon.astro";

// The hero GIF is not committed yet (see docs/media/README.md). Until it is,
// a real phone screenshot stands in; the GIF wins when it appears.
const hasHero = existsSync(new URL("../../public/media/hero.gif", import.meta.url));
const hasStill = existsSync(new URL("../../public/media/phone-terminal.png", import.meta.url));
// The iPhone app, once its screenshot is in: same terminal, native frame.
const hasIphone = existsSync(new URL("../../public/media/phone-ios.jpg", import.meta.url));

const repo = "https://github.com/zalify/offdesk";
const docs = "/docs/mac";
// /apk redirects to the newest app-v* release — see site/worker.js.
const apk = "https://offdesk.dev/apk";
const ios = "https://testflight.apple.com/join/rV4ktaGv";
const description =
  "Vibe code from your phone on the terminal you left at home. One line, one scan, and you're in.";
const install = "curl -fsSL https://offdesk.dev/install | sh";

const tunnel = [
  "git clone https://github.com/zalify/offdesk && cd offdesk",
  "$EDITOR .env   # OFFDESK_BASE_URL, TUNNEL_TOKEN, OAuth",
  "docker compose --profile tunnel up -d --build",
].join("\n");

const join = [
  "curl -fsSL https://offdesk.dev/install \\",
  "  | sh -s -- --hub-url ws://192.168.1.10:4317/ws/machine \\",
  "  --token <token>",
].join("\n");

const orchestration = `T=$(offdesk open nas --cwd ~/app --cmd claude --json | jq -r .id)
offdesk send $T \\
  "fix the type errors in src/auth.ts; stop when tests pass"
offdesk wait $T --silence 5000 --timeout 600
offdesk read $T --lines 80`;

const agents = [
  "Claude Code",
  "Codex",
  "OpenCode",
  "Gemini CLI",
  "Aider",
  "vim",
  "htop",
  "pnpm dev",
  "any CLI",
];

// Every cell is from the vendor's own documentation, checked 2026-09-01.
// Sources are in README.md, under the same table.
const columns = [
  "Any terminal program",
  "Machines per hub",
  "Traffic goes through",
  "Agents can drive it via CLI",
  "Self-hosted",
];
const rows = [
  { name: "Offdesk", self: true, cells: ["Anything that runs in tmux", "Any number, one URL", "Your own hub", "open / send / wait / read", "Yes, MIT"] },
  { name: "Claude Code Remote Control", cells: ["No — a Claude Code session, not a terminal", "Sessions from several machines in one list", "Anthropic's servers; transcript stored there", "Not documented", "No"] },
  { name: "VibeTunnel", cells: ["Yes — vt <any command>, vt --shell", "One server per machine", "Your choice: LAN, Tailscale, ngrok, Cloudflare", "Launches commands only", "Yes, MIT"] },
  { name: "Happy Coder", cells: ["No — wraps claude and codex", "Several; spawn --machine", "slopus cloud by default, end-to-end encrypted", "create / send / history / wait", "Optional, MIT"] },
  { name: "Omnara", cells: ["Agent sessions; no raw terminal documented", "Several at once per agent", "api.omnara.com by default", "CLI and REST", "Optional, Apache-2.0"] },
  { name: "Orca", cells: ["Yes — real terminal, 30+ CLI agents", "Several, via SSH worktrees and orca serve", "Orca Relay by default, or direct on the LAN", "orca terminal create/send/read/wait", "Yes, MIT"] },
];
---

<Site title="Offdesk — vibe code from your phone" description={description}>
  <!-- Hero: the whole first setup, on the machine at home. It has to fit
       one laptop screen with the three steps showing: the steps are the
       point, and a step below the fold is a step nobody takes. -->
  <section class="mx-auto max-w-6xl px-6 pt-5 pb-12 md:pt-5 md:pb-16">
    <div class="grid items-start gap-10 lg:grid-cols-[1.25fr_1fr] lg:items-center lg:gap-10">
      <div class="min-w-0">
        <p class="eyebrow inline-flex items-center gap-2">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="5" fill="#ffc857" />
            <g stroke="#ff6b57" stroke-width="2" stroke-linecap="round">
              <path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1 7 17M17 7l2.1-2.1" />
            </g>
          </svg>
          Vibe code from the beach
        </p>
        <h1 class="display mt-2 text-[2.6rem] leading-[1.04] md:text-[3.25rem]">
          Your terminal stays home. You don't have to.
        </h1>
        <p class="prose-lead mt-3 max-w-xl text-[17px]">
          The Mac at home keeps running Claude Code. Your phone opens the same
          terminal, mid-scroll, from the sand. One line to set up, one scan to get in.
        </p>

        <ol class="mt-5 space-y-3">
          <li class="flex gap-4">
            <span class="step mt-0.5">1</span>
            <div class="min-w-0 flex-1">
              <p class="font-display text-[17px] font-semibold text-ink">
                On the Mac that stays on, install the app
              </p>
              <div class="mt-2.5 flex flex-wrap items-center gap-3">
                <a href="/mac" class="btn-coral px-5 py-2.5 text-[14px]">Download for Mac</a>
                <span class="font-display text-[13px] font-semibold text-muted">Signed and notarized. Apple silicon and Intel.</span>
              </div>
              <p class="prose-body mt-2 text-[14.5px]">
                Open it, say this is the machine that stays on, and it becomes your hub:
                runs at login, restarts if it stops. Self-hosting needs no vendor account. On a NAS or a
                server with no screen, one line does the same:
              </p>
              <div class="cmd mt-2.5">
                <pre class="min-w-0 flex-1 overflow-x-auto whitespace-pre"><code><span class="cmd-prompt">$ </span>{install}</code></pre>
                <button type="button" class="cmd-copy" data-copy={install} aria-label="Copy the install command">Copy</button>
              </div>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="step mt-0.5">2</span>
            <div class="min-w-0 flex-1">
              <p class="font-display text-[17px] font-semibold text-ink">
                Scan the code it prints
              </p>
              <p class="prose-body mt-1 text-[14.5px]">
                With the iPhone or Android app, or just the phone's camera. That's the sign-in.
                Need it again later? The app's menu bar item shows it, and so does
                <span class="inline-code">offdesk link</span>.
              </p>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="step mt-0.5">3</span>
            <div class="min-w-0 flex-1">
              <p class="font-display text-[17px] font-semibold text-ink">
                That's your terminal. Go outside.
              </p>
              <p class="prose-body mt-1 text-[14.5px]">
                Same tmux session as the desk, live. Keep the hub awake and online.
                Anything that runs in tmux runs here.
              </p>
            </div>
          </li>
        </ol>

        <div class="mt-5 flex flex-wrap items-center gap-3">
          <a href={ios} class="btn-sky px-5 py-2.5 text-[14px]">iPhone app</a>
          <a href={apk} class="btn-sky px-5 py-2.5 text-[14px]">Android app</a>
          <a href="#download" class="btn-sky px-5 py-2.5 text-[14px]">All downloads</a>
          <a href={docs} class="btn-sky px-5 py-2.5 text-[14px]">Read the docs</a>
          <span class="font-display text-[13px] font-semibold text-muted">or any browser on the phone</span>
        </div>
      </div>

      {
        hasHero ? (
          <figure class="overflow-hidden rounded-[28px] border border-line bg-term shadow-[12px_12px_0_0_#ffc857]">
            <img src="/media/hero.gif" alt="Claude Code on a desk machine while a phone is attached to the same tmux session" width="1200" height="750" loading="eager" class="block w-full" />
          </figure>
        ) : hasIphone ? (
          <figure class="relative mx-auto w-full max-w-[17.5rem] lg:justify-self-end">
            <div aria-hidden="true" class="absolute -top-8 -left-10 h-24 w-24 rounded-full bg-pink/60"></div>
            <div aria-hidden="true" class="absolute -right-8 bottom-16 h-16 w-16 rounded-full border-[10px] border-sun"></div>
            <div class="relative overflow-hidden rounded-[2.6rem] border-[6px] border-ink bg-term shadow-[14px_14px_0_0_#ffc857]">
              <img src="/media/phone-ios.jpg" alt="Claude Code in the Offdesk iPhone app, attached to the Mac at home" width="1179" height="2556" loading="eager" class="block w-full" />
            </div>
            <figcaption class="mt-4 text-center font-display text-[14px] font-semibold text-muted">
              Real terminal. Real Mac at home. Real beach optional.
            </figcaption>
          </figure>
        ) : hasStill ? (
          <figure class="relative mx-auto w-full max-w-[17.5rem] lg:justify-self-end">
            <div aria-hidden="true" class="absolute -top-8 -left-10 h-24 w-24 rounded-full bg-pink/60"></div>
            <div aria-hidden="true" class="absolute -right-8 bottom-16 h-16 w-16 rounded-full border-[10px] border-sun"></div>
            <div class="relative overflow-hidden rounded-[2.4rem] border-[6px] border-ink bg-term shadow-[14px_14px_0_0_#ffc857]">
              <img src="/media/phone-terminal.png" alt="An Offdesk terminal on a phone: Claude Code on a Mac at home, attached from the phone's browser" width="390" height="844" loading="eager" class="block w-full" />
            </div>
            <figcaption class="mt-4 text-center font-display text-[14px] font-semibold text-muted">
              Real terminal. Real Mac at home. Real beach optional.
            </figcaption>
          </figure>
        ) : null
      }
    </div>
  </section>

  <!-- Wave -->
  <div aria-hidden="true" class="-mb-1">
    <svg viewBox="0 0 1440 60" class="block h-10 w-full md:h-14" preserveAspectRatio="none">
      <path d="M0 30 C 180 60, 360 0, 540 30 S 900 60, 1080 30 S 1350 0, 1440 30 L1440 60 L0 60 Z" fill="#fffbf4" />
    </svg>
  </div>

  <!-- Download: every client, one place -->
  <section id="download" class="bg-cream">
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-24">
      <p class="eyebrow">Download</p>
      <h2 class="display mt-3 max-w-2xl text-4xl md:text-5xl">
        One app for the desk, one for the phone.
      </h2>
      <p class="prose-lead mt-4 max-w-2xl">
        The desktop app is the hub on a Mac, and a client everywhere. The phone
        apps wrap the same terminal the browser shows.
      </p>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        <div class="card">
          <h3 class="display text-2xl">macOS</h3>
          <p class="prose-body mt-3">
            One dmg for Apple silicon and Intel. Signed with a Developer ID and
            notarized, so it opens like anything from the App Store. On the Mac
            that stays on it becomes your hub; anywhere else it is a client.
          </p>
          <a href="/mac" class="btn-coral mt-6 px-5 py-2.5 text-[14px]">Download for Mac</a>
          <p class="mt-3 font-mono text-[12px] text-faint">macOS 11 or later · universal · .dmg</p>
        </div>
        <div class="card">
          <h3 class="display text-2xl">Windows</h3>
          <p class="prose-body mt-3">
            A client: it opens the terminals on a hub somewhere else. Paste the
            link the hub printed, or sign in. A Windows machine cannot be the
            hub, which needs tmux.
          </p>
          <a href="/windows" class="btn-sky mt-6 px-5 py-2.5 text-[14px]">Download for Windows</a>
          <p class="mt-3 font-mono text-[12px] text-faint">x64 · .msi</p>
        </div>
        <div class="card">
          <h3 class="display text-2xl">Linux</h3>
          <p class="prose-body mt-3">
            A client, as on Windows. For a Linux box that should be the hub,
            the one-line install is the way: it runs the hub as a service.
          </p>
          <a href="/linux" class="btn-sky mt-6 px-5 py-2.5 text-[14px]">Download for Linux</a>
          <p class="mt-3 font-mono text-[12px] text-faint">x64 · .AppImage · .deb and .rpm on <a href="/desktop" class="text-sea">the release page</a></p>
        </div>
      </div>
      <div class="mt-6 grid gap-6 md:grid-cols-3">
        <div class="card">
          <h3 class="display text-2xl">iPhone</h3>
          <p class="prose-body mt-3">
            Available through TestFlight. Open the invitation on your iPhone or
            iPad, install the app, then choose Scan QR Code to connect to your hub.
          </p>
          <a href={ios} class="btn-sky mt-6 px-5 py-2.5 text-[14px]">Get the iPhone app</a>
        </div>
        <div class="card">
          <h3 class="display text-2xl">Android</h3>
          <p class="prose-body mt-3">
            An APK to sideload. Take <span class="inline-code">arm64-v8a</span> on
            a modern phone, <a href="/apk/universal">universal</a> if unsure.
          </p>
          <a href={apk} class="btn-sky mt-6 px-5 py-2.5 text-[14px]">Download the APK</a>
        </div>
        <div class="card">
          <h3 class="display text-2xl">Hub, node and CLI</h3>
          <p class="prose-body mt-3">
            The three binaries, for a NAS, a VPS, or any machine without a
            screen. Linux and macOS, x64 and arm64.
          </p>
          <div class="cmd mt-6">
            <pre class="min-w-0 flex-1 overflow-x-auto whitespace-pre"><code><span class="cmd-prompt">$ </span>{install}</code></pre>
            <button type="button" class="cmd-copy" data-copy={install} aria-label="Copy the install command">Copy</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section id="how" class="bg-cream">
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-24">
      <p class="eyebrow">How it works</p>
      <h2 class="display mt-3 max-w-2xl text-4xl md:text-5xl">
        Three small things, and nothing in the middle.
      </h2>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        <div class="card">
          <div class="flex items-center gap-3">
            <span class="step">1</span>
            <h3 class="display text-2xl">Hub</h3>
          </div>
          <p class="prose-body mt-4">
            One process on the machine that stays on. SQLite beside it, the web
            UI baked in. It knows every machine you own, and it's the only
            address a client ever needs.
          </p>
          <code class="mt-4 block font-mono text-[12px] text-faint">offdesk-hub</code>
        </div>
        <div class="card">
          <div class="flex items-center gap-3">
            <span class="step">2</span>
            <h3 class="display text-2xl">Node</h3>
          </div>
          <p class="prose-body mt-4">
            On every machine you want to reach. It dials <em>out</em> to the
            hub and keeps one socket open, so nothing needs a port or a public
            IP. Every terminal is a tmux session on the machine that owns it:
            it outlives the app, the network, and you walking away. Uninstall
            Offdesk and it's still there.
          </p>
          <code class="mt-4 block font-mono text-[12px] text-faint">offdesk-node · tmux</code>
        </div>
        <div class="card">
          <div class="flex items-center gap-3">
            <span class="step">3</span>
            <h3 class="display text-2xl">Client</h3>
          </div>
          <p class="prose-body mt-4">
            Anything that talks to the hub: a browser tab, the phone app, the
            desktop app, the CLI, another agent on another machine. A client
            never touches a node directly, so whoever typed last holds the
            keyboard and everyone else watches live.
          </p>
          <code class="mt-4 block font-mono text-[12px] text-faint">browser · phone · desktop · offdesk</code>
        </div>
      </div>
      <p class="prose-body mt-8 max-w-2xl">
        Two screens on one terminal are two clients of one hub, attached to
        one tmux session. A phone attaching never resizes the desk; a phone
        typing does, and the desk gets a one-click fit back.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-12">
    <div class="card">
      <p class="eyebrow">September update</p>
      <h2 class="display mt-3 text-2xl">A clearer first install. A ready-to-connect Mac.</h2>
      <p class="prose-body mt-3">
        Hub 0.20.4, desktop 0.6.4 and mobile 0.6.6 improve first-time setup and
        startup reconnection. The Mac checks that its Hub and machine are ready
        before phone pairing, with automatic setup recovery and a clearer installer.
        This release also fixes Mac Chinese punctuation and improves Android
        system-navigation spacing.
        iOS updates become public through TestFlight after Apple’s beta review.
      </p>
      <p class="prose-body mt-3">
        Optional Offdesk Cloud beta adds guided remote setup under
        <span class="inline-code">*.cloud.offdesk.dev</span>.
        The Hub and Apps are open source; the managed Cloud service is separate.
      </p>
      <a href={`${repo}/blob/main/docs/managed-connections.md`} class="btn-sky mt-5">Cloud beta setup</a>
    </div>
  </section>

  <!-- Away from home: the tunnel -->
  <section id="away" class="mx-auto max-w-6xl px-6 py-16 md:py-24">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:gap-16">
      <div>
        <p class="eyebrow">Away from home</p>
        <h2 class="display mt-3 text-4xl md:text-5xl">
          Not on the Wi-Fi? Tunnel home.
        </h2>
        <p class="prose-lead mt-6">
          A Cloudflare Tunnel runs next to the hub and dials out, so the hub at
          home gets an <span class="inline-code">https://</span> address with
          no port opened, no DNS to babysit, and it works behind CGNAT. The free
          plan is enough.
        </p>
        <p class="prose-body mt-4">
          Pair in the App for end-to-end encryption: terminal content stays
          encrypted between your phone and Hub, including through a tunnel.
          Ordinary browser connections use HTTPS, which the tunnel provider
          terminates. See the <a href={`${repo}/blob/main/docs/encrypted-connections.md`}>encrypted connection guide</a>
          or use a <a href={`${repo}/blob/main/docs/setup-public.md#tailscale`}>tailnet</a>.
        </p>
        <a href="/tunnel" class="btn-coral mt-8">The tunnel guide</a>
      </div>
      <div class="card min-w-0">
        <p class="font-display text-lg font-semibold text-ink">On the machine at home</p>
        <p class="prose-body mt-2 text-[15px]">
          Create the tunnel in Cloudflare's dashboard, point it at
          <span class="inline-code">server:4317</span>, drop its token in
          <span class="inline-code">.env</span>, and:
        </p>
        <div class="cmd mt-5">
          <pre class="min-w-0 flex-1 overflow-x-auto whitespace-pre"><code>{tunnel.split("\n").map((line) => (<span class="block"><span class="cmd-prompt">$ </span>{line}</span>))}</code></pre>
          <button type="button" class="cmd-copy" data-copy={tunnel} aria-label="Copy the tunnel commands">Copy</button>
        </div>
        <p class="prose-body mt-4 text-[15px]">
          For encrypted App access, scan the encrypted pairing code with the
          App's scanner. For ordinary browser access, configure authentication
          as described in the tunnel guide.
        </p>
      </div>
    </div>
  </section>

  <!-- More scenarios -->
  <section id="more" class="bg-cream">
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-24">
      <p class="eyebrow">More</p>
      <h2 class="display mt-3 max-w-2xl text-4xl md:text-5xl">
        A second machine, the phone, the agents.
      </h2>
      <div class="mt-12 grid gap-6 lg:grid-cols-3">
        <div class="card min-w-0">
          <h3 class="display text-2xl">A second machine</h3>
          <p class="prose-body mt-3">
            The NAS, the VPS, the laptop. Open the hub, choose <strong>Add
            host</strong>, and it hands you one line with a token in it. Paste it
            on that machine; it shows up.
          </p>
          <pre class="term mt-5 overflow-x-auto p-4 text-[12.5px]"><code>{join}</code></pre>
        </div>
        <div id="phone" class="card min-w-0 scroll-mt-24">
          <h3 class="display text-2xl">Your phone</h3>
          <p class="prose-body mt-3">
            A key bar for Ctrl, Esc and the arrows, because agents ask questions
            and builds need a Ctrl‑C. The apps add a QR scanner and end-to-end
            encrypted connections. You can also use a browser with the hub’s sign-in link.
          </p>
          <p class="prose-body mt-3">
            <strong class="text-ink">iPhone and iPad:</strong> join the public
            TestFlight beta using the link below. TestFlight handles app updates.
          </p>
          <div class="mt-5 flex flex-wrap gap-2">
            <a href={apk} class="btn-coral px-5 py-2.5 text-[14px]">Android APK</a>
            <a href="https://offdesk.dev/apk/universal" class="btn-sky px-5 py-2.5 text-[14px]">universal build</a>
            <a href={ios} class="btn-sky px-5 py-2.5 text-[14px]">iPhone · TestFlight</a>
          </div>
        </div>
        <div class="card min-w-0">
          <h3 class="display text-2xl">Bring any agent</h3>
          <p class="prose-body mt-3">
            Offdesk doesn't wrap an agent or speak its protocol. It hands you the
            terminal the agent already runs in — your subscription, your config,
            your dotfiles.
          </p>
          <ul class="mt-5 flex flex-wrap gap-2">
            {agents.map((a) => (<li class="rounded-full border-2 border-line-2 bg-sand px-3 py-1 font-mono text-[12.5px] text-ink">{a}</li>))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- For agents -->
  <section id="agents" class="mx-auto max-w-6xl px-6 py-16 md:py-24">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.1fr] lg:gap-14">
      <div>
        <p class="eyebrow">For agents</p>
        <h2 class="display mt-3 text-4xl md:text-5xl">
          One token, and any agent can drive any machine you own.
        </h2>
        <p class="prose-lead mt-6">
          Open a terminal on any registered machine, type into it, wait for it
          to go quiet, read it back. Not an agent session — a terminal, so what
          you drive is what you'd have run by hand.
        </p>
        <p class="prose-body mt-4">
          A token is remote code execution on every machine you registered.
          Mint one per agent, name it, revoke it alone.
          <a href={`${repo}/blob/main/SECURITY.md`}>SECURITY.md</a>
        </p>
      </div>
      <div class="cmd min-w-0">
        <pre class="min-w-0 flex-1 overflow-x-auto whitespace-pre text-[12.5px]"><code>{orchestration}</code></pre>
        <button type="button" class="cmd-copy" data-copy={orchestration} aria-label="Copy the example">Copy</button>
      </div>
    </div>
  </section>

  <!-- Compare -->
  <section id="compare" class="bg-cream">
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-24">
      <p class="eyebrow">How it compares</p>
      <h2 class="display mt-3 max-w-3xl text-3xl md:text-4xl">
        The ones that gather machines hand you a chat. The ones that hand you a terminal run one server per machine.
      </h2>
      <p class="prose-body mt-4 max-w-2xl">
        Every cell is from that project's own documentation, checked
        2026-09-01. Sources are under the same table in the README.
      </p>
      <div class="mt-8 overflow-x-auto rounded-[22px] border border-line bg-sand">
        <table class="w-full min-w-[56rem] border-collapse text-left text-[14px]">
          <thead>
            <tr>
              <th scope="col" class="px-4 py-3"></th>
              {columns.map((c) => <th scope="col" class="px-4 py-3 align-bottom font-display text-[13px] font-semibold text-muted">{c}</th>)}
            </tr>
          </thead>
          <tbody>
            {rows.map((row) => (
              <tr class:list={["border-t border-line", { "bg-sun/25": row.self }]}>
                <th scope="row" class:list={["px-4 py-3 align-top font-display font-semibold", row.self ? "text-coral" : "text-ink"]}>{row.name}</th>
                {row.cells.map((cell) => (
                  <td class:list={["px-4 py-3 align-top leading-snug", /not documented/i.test(cell) ? "text-faint" : "text-ink-2"]}>{cell}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Close -->
  <section class="mx-auto max-w-6xl px-6 py-20 md:py-28">
    <div class="relative max-w-3xl">
      <div aria-hidden="true" class="absolute -top-10 right-0 h-20 w-20 rounded-full border-[12px] border-coral/70 md:-right-24"></div>
      <h2 class="display text-4xl md:text-6xl">Go on. Leave the desk.</h2>
      <p class="prose-lead mt-6 max-w-xl">
        The session keeps running at home. Your phone opens the same terminal,
        mid-scroll.
      </p>
      <div class="cmd mt-9 max-w-xl">
        <pre class="min-w-0 flex-1 overflow-x-auto whitespace-pre"><code><span class="cmd-prompt">$ </span>{install}</code></pre>
        <button type="button" class="cmd-copy" data-copy={install} aria-label="Copy the install command">Copy</button>
      </div>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={repo} class="btn-coral"><Icon name="github" />GitHub</a>
        <a href="https://discord.gg/aFUu6VMzc" class="btn-sky"><Icon name="discord" />Discord</a>
        <a href={ios} class="btn-sky">iPhone app</a>
        <a href={apk} class="btn-sky">Android app</a>
      </div>
    </div>
  </section>
</Site>
