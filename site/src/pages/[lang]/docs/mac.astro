---
import MacSetupGuide from "../../../components/MacSetupGuide.astro";
import { prefixedLocales, type Locale } from "../../../i18n";

export function getStaticPaths() {
  return prefixedLocales.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;
---
<MacSetupGuide locale={lang} />
