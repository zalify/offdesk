# Rust binaries: compiled here by default (`pnpm e2e:test`), or taken from
# e2e/.prebuilt/ with E2E_RUST_BINARIES=prebuilt. CI compiles both once per
# change to crates/ (the rust-build stage with
# E2E_CARGO_BINS="--bin offdesk-hub --bin offdesk-node") and hands them to
# every E2E shard; see .github/workflows/ci.yml.
ARG E2E_RUST_BINARIES=build
FROM rust:bookworm AS rust-build
ARG E2E_CARGO_BINS="--bin offdesk-node"
WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY crates crates
RUN cargo build --release $E2E_CARGO_BINS \
    && mkdir /out \
    && find target/release -maxdepth 1 -type f -name 'offdesk-*' -perm -u+x -exec cp {} /out/ \;

FROM scratch AS rust-prebuilt
COPY e2e/.prebuilt/ /out/

FROM rust-${E2E_RUST_BINARIES} AS rust

FROM node:22-bookworm-slim
# tmux from bookworm-backports: >= 3.4 sends OSC 10/11 colour queries on every
# attach and passes OSC 8 hyperlinks through, like the machines we run on.
RUN echo "deb http://deb.debian.org/debian bookworm-backports main" > /etc/apt/sources.list.d/backports.list \
    && apt-get update \
    && apt-get install -y ca-certificates bash coreutils python3 chromium fonts-liberation \
    && apt-get install -y -t bookworm-backports tmux \
    && rm -rf /var/lib/apt/lists/*
COPY --from=rust /out/offdesk-node /usr/local/bin/
# Fake ACP agent for agent-session tests; machine.json points every agent
# kind at it (its machine_id must match the compose `--id e2e-node`).
COPY e2e/fake-acp-agent.py /opt/offdesk/fake-acp-agent.py
COPY e2e/machine.json /root/.config/offdesk/machine.json
COPY e2e/preview-fixture /opt/offdesk/preview-fixture
RUN cd /opt/offdesk/preview-fixture && npm ci --no-audit --no-fund

# UTF-8 locale so tmux and readline handle multibyte input/echo (CJK IME
# e2e tests); bookworm's glibc always ships C.UTF-8.
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8

# Headless Chromium for the agent browser (e2e/tests/agent-browser.spec.ts);
# the node runs as root in the container, which needs --no-sandbox.
ENV OFFDESK_CHROMIUM=/usr/bin/chromium OFFDESK_CHROMIUM_NO_SANDBOX=1

CMD ["offdesk-node"]
