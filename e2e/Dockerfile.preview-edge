FROM nginx:stable-alpine
RUN apk add --no-cache openssl && mkdir -p /etc/nginx/tls && \
    openssl req -x509 -newkey rsa:2048 -nodes -days 30 \
      -keyout /etc/nginx/tls/key.pem -out /etc/nginx/tls/cert.pem \
      -subj '/CN=*.preview.test' -addext 'subjectAltName=DNS:*.preview.test'
COPY e2e/preview-edge.conf /etc/nginx/conf.d/default.conf
